{
  "manifest_version": 3,
  "name": "Disable Tender Button",
  "version": "1.0",
  "description": "Disables the Tender button on the POS page.",
  "content_scripts": [
    {
      "matches": [
        "http://hbu-pos:8080/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}